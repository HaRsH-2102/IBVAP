# ============================================================
# IBVAP Backend — Environment Variables
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to git.
# ============================================================

# --- Application ---
IBVAP_LOG_LEVEL=INFO
IBVAP_API_HOST=0.0.0.0
IBVAP_API_PORT=8000
IBVAP_API_VERSION=v1

# --- CORS ---
# Comma-separated list of allowed origins for the frontend
IBVAP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Storage (future) ---
IBVAP_STORAGE_BASE_PATH=./storage
IBVAP_EVIDENCE_RETENTION_DAYS=30

# --- Database (future — Milestone 14) ---
# IBVAP_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ibvap

# --- Processing ---
IBVAP_DEFAULT_CONFIDENCE_THRESHOLD=0.5
IBVAP_LOITERING_THRESHOLD_SECONDS=60
IBVAP_NIGHT_START_HOUR=20
IBVAP_NIGHT_END_HOUR=6
IBVAP_MAX_CAMERAS=16
IBVAP_PROCESSING_FPS_LIMIT=25

# --- Camera credentials (future) ---
# Do NOT hard-code camera stream URLs with credentials here as plain text in production.
# Use a secrets manager in production deployments.
# Example:
# CAM_001_STREAM_URL=rtsp://user:password@192.168.1.100:554/stream1
