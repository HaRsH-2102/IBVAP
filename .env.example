# ============================================================
# IBVAP — .env.example
# ============================================================
# Copy this file to .env and replace with actual values.
# Do NOT commit real credentials to GitHub.

# --- Frontend ---
VITE_IBVAP_DEMO_MODE=true

# --- Backend Application ---
IBVAP_LOG_LEVEL=INFO
IBVAP_API_HOST=0.0.0.0
IBVAP_API_PORT=8000
IBVAP_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# --- Database ---
IBVAP_DATABASE_URL=sqlite:///./m6_events.db
IBVAP_SQLITE_DB_PATH=m6_events.db

# --- Storage ---
IBVAP_STORAGE_BASE_PATH=./storage
IBVAP_EVIDENCE_RETENTION_DAYS=30

# --- Processing / AI ---
IBVAP_DETECTOR_MODEL_PATH=rtdetr-l.pt
IBVAP_ANPR_DETECTOR_MODEL_PATH=best.pt
IBVAP_DETECTOR_DEVICE=auto
IBVAP_MAX_CAMERAS=16
IBVAP_PROCESSING_FPS_LIMIT=25
